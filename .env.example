# MongoDB connection string.
# Default dev setup (mongodb-atlas-local container from notes.txt / start-dev.bat):
#   mongodb://root:password123@localhost:27017/Dashboard-Database?directConnection=true&authSource=admin
# If you run MongoDB via docker-compose (replica set named "replicaset", no auth):
#   mongodb://localhost:27017/Dashboard-Database?replicaSet=replicaset&directConnection=true
MONGODB_URI=mongodb://root:password123@localhost:27017/Dashboard-Database?directConnection=true&authSource=admin

# Database name (also set via the path in MONGODB_URI)
DB_NAME=Dashboard-Database

# Secrets for signing access (1h) and refresh (7d) tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Comma-separated list of allowed frontend origins (default: allow all)
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Server port (default 3000)
PORT=3000

# Winston log level: error | warn | info | debug (default info)
LOG_LEVEL=info
